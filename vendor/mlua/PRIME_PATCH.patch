+    let lua = Lua::new();
+    lua.globals().set("await_echo", lua.create_async_function(|_, value: i64| async move {
+        tokio::task::yield_now().await;
+        tokio::task::yield_now().await;
+        Ok((value, "echo"))
+    })?)?;
+    let function = lua.load(r#"
+        local initial = ...
+        assert(initial == 42)
