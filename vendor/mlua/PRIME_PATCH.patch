+        assert!(execution.wake_debt.load(Ordering::SeqCst));
+        assert!(Pin::new(&mut execution).poll(&mut cx).is_pending());
+        assert_eq!(polls.load(Ordering::SeqCst), 3);
+        assert!(!execution.wake_debt.load(Ordering::SeqCst));
